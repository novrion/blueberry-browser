# openai (default) | anthropic | google
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Code execution sandbox backend.
#   - "microvm" (default if SANDBOX_URL is set): self-hosted Firecracker
#     orchestrator from services/sandbox.
#   - "e2b" (default otherwise): hosted e2b.dev.
SANDBOX_BACKEND=
SANDBOX_URL=http://localhost:8080
# Optional bearer token if the orchestrator is fronted by auth.
SANDBOX_TOKEN=

# E2B (only used when SANDBOX_BACKEND=e2b or microvm is unavailable).
E2B_API_KEY=
