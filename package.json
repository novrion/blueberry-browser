{
  "name": "blueberry-browser-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Blueberry Browser monorepo: Electron app + sandbox service",
  "scripts": {
    "dev": "pnpm --filter blueberry-browser dev",
    "build": "pnpm --filter blueberry-browser build",
    "lint": "pnpm --filter blueberry-browser lint",
    "typecheck": "pnpm --filter blueberry-browser typecheck",
    "format": "pnpm -r --if-present run format",
    "start": "pnpm --filter blueberry-browser start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
